+static void polaris10_smu_trace(struct pp_hwmgr *hwmgr, const char *stage)
+{
+	pr_info("SMU_DIAG %s pc=%08x status=%08x events=%08x flags=%08x resp=%08x\n",
+		stage,
+		cgs_read_ind_register(hwmgr->device, CGS_IND_REG__SMC, ixSMC_PC_C),
+		cgs_read_ind_register(hwmgr->device, CGS_IND_REG__SMC, ixSMU_STATUS),
+		cgs_read_ind_register(hwmgr->device, CGS_IND_REG__SMC, ixRCU_UC_EVENTS),
+		cgs_read_ind_register(hwmgr->device, CGS_IND_REG__SMC, ixFIRMWARE_FLAGS),
+		cgs_read_register(hwmgr->device, mmSMC_RESP_0));
+}
+
