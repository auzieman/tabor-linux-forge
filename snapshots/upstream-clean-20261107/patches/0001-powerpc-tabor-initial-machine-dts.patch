From: Auzieman / AuzieTek
Subject: [PATCH] powerpc/85xx: add initial Tabor machine and vendor-derived DTS

Forward-port the A1222 machine identity and P1022 common initialization to
Linux 6.12 define_machine compatible matching. Retain the vendor DTS layout
and notices with include paths relative to its new fsl directory.

This is an initial serial/PCI compilation slice. Vendor audio and board
reset/power controls remain to port and test; no boot acceptance claimed.

diff --git a/arch/powerpc/platforms/85xx/Kconfig b/arch/powerpc/platforms/85xx/Kconfig
--- a/arch/powerpc/platforms/85xx/Kconfig
+++ b/arch/powerpc/platforms/85xx/Kconfig
@@ -120,6 +120,14 @@
 	  MHz and 1600 DMIPS, additional functionality and faster interfaces
 	  (DDR3/3L, SATA II, and PCI  Express).
 
+config TABOR
+	bool "A-EON / Varisys Tabor (A1222)"
+	select DEFAULT_UIMAGE
+	select SWIOTLB
+	help
+	  Initial Tabor P1022 board enablement for serial/PCI bring-up.
+	  Board power control and audio are separate forward-port slices.
+
 config P1022_DS
 	bool "Freescale P1022 DS"
 	select DEFAULT_UIMAGE
diff --git a/arch/powerpc/platforms/85xx/Makefile b/arch/powerpc/platforms/85xx/Makefile
--- a/arch/powerpc/platforms/85xx/Makefile
+++ b/arch/powerpc/platforms/85xx/Makefile
@@ -35,3 +35,5 @@
 obj-$(CONFIG_PPC_QEMU_E500) += qemu_e500.o
 obj-$(CONFIG_SGY_CTS1000) += sgy_cts1000.o
 obj-$(CONFIG_MVME2500)	  += mvme2500.o
+
+obj-$(CONFIG_TABOR) += tabor.o
diff --git a/arch/powerpc/platforms/85xx/tabor.c b/arch/powerpc/platforms/85xx/tabor.c
new file mode 100644
--- /dev/null
+++ b/arch/powerpc/platforms/85xx/tabor.c
@@ -0,0 +1,72 @@
+/*
+ * Tabor (A1222/P1022) initial board routines
+ *
+ * Copyright 2012 Freescale Semiconductor, Inc.
+ *
+ * Author: Timur Tabi <timur@freescale.com>
+ *
+ * Based on tabor.c and the A-EON 5.4-rc3 Tabor patch.
+ * Initial serial/PCI slice; no DIU, audio or board power controls yet.
+ *
+ * This file is licensed under the terms of the GNU General Public License
+ * version 2.  This program is licensed "as is" without any warranty of any
+ * kind, whether express or implied.
+ */
+
+#include <linux/fsl/guts.h>
+#include <linux/pci.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <asm/div64.h>
+#include <asm/mpic.h>
+#include <asm/swiotlb.h>
+
+#include <sysdev/fsl_soc.h>
+#include <sysdev/fsl_pci.h>
+#include <asm/udbg.h>
+#include "smp.h"
+
+#include "mpc85xx.h"
+
+
+static void __init tabor_pic_init(void)
+{
+	struct mpic *mpic = mpic_alloc(NULL, 0, MPIC_BIG_ENDIAN |
+		MPIC_SINGLE_DEST_CPU,
+		0, 256, " OpenPIC  ");
+	BUG_ON(mpic == NULL);
+	mpic_init(mpic);
+}
+
+/*
+ * Setup the architecture
+ */
+static void __init tabor_setup_arch(void)
+{
+	if (ppc_md.progress)
+		ppc_md.progress("tabor_setup_arch()", 0);
+
+
+	mpc85xx_smp_init();
+
+	fsl_pci_assign_primary();
+
+	swiotlb_detect_4g();
+
+	pr_info("A-EON / Varisys Tabor\n");
+}
+
+machine_arch_initcall(tabor, mpc85xx_common_publish_devices);
+
+define_machine(tabor) {
+	.name			= "Tabor",
+	.compatible		= "fsl,tabor",
+	.setup_arch		= tabor_setup_arch,
+	.init_IRQ		= tabor_pic_init,
+#ifdef CONFIG_PCI
+	.pcibios_fixup_bus	= fsl_pcibios_fixup_bus,
+	.pcibios_fixup_phb      = fsl_pcibios_fixup_phb,
+#endif
+	.get_irq		= mpic_get_irq,
+	.progress		= udbg_progress,
+};
